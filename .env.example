# Copy to .env to override defaults (docker compose reads it automatically).
# Sources to import: "default" (synthetic fixtures), a comma list of registry ids, or "all".
# Example with real open data:  ENABLED_SOURCES=default,flixbus-eu-gtfs,blablacar-bus-gtfs,gtfs-de-fv
ENABLED_SOURCES=flixbus-eu-gtfs,blablacar-bus-gtfs,gtfs-de-fv
# Which data the API searches when the request does not say: all | real | synthetic
DEFAULT_DATA_SCOPE=real
# 1 = public deployment: never import, search or list synthetic fixtures (overrides ?scope=synthetic).
# Leave empty for development and tests, which rely on the fixtures.
DISABLE_FIXTURES=1
# Optional: FX factors to compare prices in different currencies, e.g. {"CHF":1.05}
FX_RATES_TO_EUR=
# Optional: OSRM foot-profile router for OSM-based walking transfers, e.g. http://osrm:5000
PEDESTRIAN_ROUTER_URL=
# Enables /internal/v1/* endpoints when set
INTERNAL_API_TOKEN=
POSTGRES_PORT=55432
REDIS_PORT=56379
API_PORT=4080
WEB_PORT=3000
