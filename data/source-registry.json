    {
      "id": "flixbus-eu-gtfs",
      "name": "FlixBus / FlixTrain Europe GTFS (static timetable)",
      "kind": "gtfs-schedule",
      "adapter": "gtfs-url",
      "adapterStatus": "implemented",
      "synthetic": false,
      "enabledByDefault": false,
      "priority": 10,
      "config": { "url": "https://gtfs.gis.flix.tech/gtfs_generic_eu.zip" },
      "license": "ODbL 1.0 + transport.data.gouv.fr Conditions Particulières",
      "licenseUrl": "https://opendatacommons.org/licenses/odbl/1.0/",
      "attribution": "Timetable data: FlixBus France SARL / FlixMobility, published on transport.data.gouv.fr under ODbL 1.0",
      "homepage": "https://transport.data.gouv.fr/datasets/flixbus-horaires-theoriques-du-reseau-europeen-1",
      "refreshHours": 24,
      "researchId": "flixbus-gtfs-eu",
      "operators": {
        "*": { "bookingLinkKind": "operator_homepage" }
      },
      "notes": "Agency time zone is UTC; stops carry stop_timezone. Feed contains only generic shop URLs, so booking links are labelled as operator homepage links."
    },
